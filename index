<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHub Upload / Import Page</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f6f8fa;
            color: #24292e;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .upload-container {
            background-color: #ffffff;
            border: 1px solid #e1e4e8;
            border-radius: 6px;
            padding: 30px;
            width: 400px;
            box-shadow: 0 4px 12px rgba(27, 31, 35, 0.05);
            text-align: center;
        }
        h2 {
            margin-bottom: 20px;
            font-size: 22px;
            color: #0366d6;
        }
        .drop-zone {
            border: 2px dashed #c8e1ff;
            border-radius: 6px;
            padding: 30px;
            background-color: #f1f8ff;
            cursor: pointer;
            margin-bottom: 20px;
            transition: background-color 0.2s;
        }
        .drop-zone:hover {
            background-color: #dbedff;
        }
        .drop-zone p {
            margin: 0;
            color: #586069;
            font-size: 14px;
        }
        input[type="file"] {
            display: none;
        }
        .btn {
            background-color: #2ea44f;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.2s;
        }
        .btn:hover {
            background-color: #2c974b;
        }
        #file-name {
            margin-top: 10px;
            font-size: 13px;
            color: #6a737d;
            word-break: break-all;
        }
    </style>
</head>
<body>

    <div class="upload-container">
        <h2>Import / Upload to GitHub</h2>
        <form action="#" method="POST" enctype="multipart/form-data">
            <label for="file-upload" class="drop-zone" id="drop-zone">
                <p>I-drag ang file dito o <strong>mag-click para mamili</strong></p>
                <input type="file" id="file-upload" name="file">
            </label>
            <div id="file-name">Walang napiling file</div>
            <br>
            <button type="submit" class="btn">Upload File</button>
        </form>
    </div>

    <script>
        const fileInput = document.getElementById('file-upload');
        const fileNameDisplay = document.getElementById('file-name');

        fileInput.addEventListener('change', function() {
            if (fileInput.files.length > 0) {
                fileNameDisplay.textContent = `Napili: ${fileInput.files[0].name}`;
            } else {
                fileNameDisplay.textContent = 'Walang napiling file';
            }
        });
    </script>

</body>
</html>
